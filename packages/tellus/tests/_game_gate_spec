use cribbage_tellus::prelude::{
    DeckSource, Game, GameCommand, GameEvent, GameId, GameState, PersistedCards, UserId,
};

use fixture::EntityFixture;
use shuffled_deck_source::ShuffledDeckSource;
use tellus::EventSourced;

#[tokio::test]
async fn user_creates_game() {
    let deck_source = ShuffledDeckSource::new();
    let deck = PersistedCards::from(deck_source.new_deck().as_ref());
    let host = UserId::new();

    let game = Game::new(GameId::new(), deck_source);
    let id = game.persistence_id();

    EntityFixture::new(game, id)
        .when_tell(GameCommand::Create {
            host,
            deck: deck.clone(),
        })
        .await
        .then_events(&[GameEvent::GameCreated { host, deck }]);
}

#[tokio::test]
async fn user_joins_game() {
    let deck_source = ShuffledDeckSource::new();
    let deck = PersistedCards::from(deck_source.new_deck().as_ref());
    let host = UserId::new();
    let guest = UserId::new();

    let game = Game::new(GameId::new(), deck_source);
    let id = game.persistence_id();

    EntityFixture::new(game, id)
        .given_event(&GameEvent::GameCreated { host, deck })
        .await
        .when_tell(GameCommand::Join { guest })
        .await
        .then_events(&[GameEvent::GuestJoined { guest }]);
}

